{# Aspendora white-label: core's version hardcodes "Matomo" in the link title and the img alt.
   Structure is otherwise core's, including the SVG-first branch — images/logo.svg is the brand's
   vector master (aspendora-logo-dark.svg: white wordmark, gradient mark), which is the sanctioned
   file for navy grounds, and every surface this template renders on is navy.
   Piwik\Plugins\CoreAdminHome\CustomLogo resolves these from the active theme automatically; a
   logo uploaded in Administration → Brand still wins. #}
<span id="logo" class="logo brand-logo {% if centeredLogo is defined and centeredLogo %}center{% endif %}">
    {% if logoLink is not defined or logoLink is not empty %}
    <a href="{{ logoLink|default('index.php') }}" tabindex="3" title="Aspendora Analytics">
    {% endif %}
    {% if hasSVGLogo %}
        <img src='{{ logoSVG }}?aspendora' alt="Aspendora Analytics" />
    {% else %}
        <img src='{% if useLargeLogo|default(false) %}{{ logoLarge }}{% else %}{{ logoHeader }}{% endif %}?aspendora'
             alt="Aspendora Analytics" />
    {% endif %}
    {% if logoLink is not defined or logoLink is not empty %}
    </a>
    {% endif %}
</span>
