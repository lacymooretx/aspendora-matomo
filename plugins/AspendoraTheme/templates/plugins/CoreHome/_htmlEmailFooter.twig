{# Aspendora white-label: identical to core minus the "Powered by Matomo Analytics" credit.
   Core only suppresses that block for the paid WhiteLabel plugin (it checks for a plugin
   literally named "WhiteLabel"), so scheduled reports going to clients would otherwise carry
   it. Matomo attribution stays in the source, LEGALNOTICE and the About page. #}
{% set fontStyle %}color:{{ themeStyles.getPropertyValue('colorText')|e('html_attr') }};font-family:{{ themeStyles.getPropertyValue('fontFamilyBase')|e('html_attr') }};{% endset %}
{% set styleParagraph = 'font-size:15px;line-height:24px;margin:0 0 16px;' %}
{% set footerParagraphStyle %}{{styleParagraph}}{{fontStyle}}text-align:center;font-size:13px; color:#64748b;{% endset %}

{% if unsubscribeLink|default is not empty %}
    <hr style=" border: 0; margin-top: 50px;  height: 1px; background-image: linear-gradient(to right, rgba(226, 232, 240, 0), rgba(226, 232, 240, 1), rgba(226, 232, 240, 0));">
{% else %}
    <br/>
{% endif %}

{% if unsubscribeLink|default is not empty %}
    {% set unsubLink %}<a style="color:#2563eb;" href="{{ unsubscribeLink|e('html_attr') }}">{{ 'ScheduledReports_Unsubscribe'|translate }}</a>{% endset %}
    <p style='{{ footerParagraphStyle }}padding-top:30px;'>{{ 'ScheduledReports_UnsubscribeFooter'|translate(unsubLink)|raw }}.</p>
{% endif %}

</div>
</body>
</html>
